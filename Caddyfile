# HTTP plano en el puerto interno: el TLS y el dominio los resuelve
# el proxy de EasyPanel (Traefik) por delante de este contenedor.
:80 {
	root * /srv
	file_server
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Imagenes: una semana de cache. Si se cambia una, va con nombre nuevo
	# (ej. tat-sobre-2.jpg) para que nadie siga viendo la vieja.
	@assets path *.woff2 *.jpg *.png *.webp *.svg
	header @assets Cache-Control "public, max-age=604800"

	# HTML, CSS y JS se revalidan siempre (con el ETag es un 304 barato).
	# Con una semana de cache el celu mezclaba el HTML nuevo con el CSS viejo.
	@code path / /index.html *.css *.js
	header @code Cache-Control "no-cache"
}
