# HTTP plano en el puerto interno: el TLS y el dominio los resuelve
# el proxy de EasyPanel (Traefik) por delante de este contenedor.
:80 {
	root * /srv
	file_server
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@assets path *.css *.js *.woff2 *.jpg *.png *.webp *.svg
	header @assets Cache-Control "public, max-age=604800"
	header /index.html Cache-Control "no-cache"
}
